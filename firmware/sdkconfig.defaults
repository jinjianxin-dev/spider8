# =============================================================
# Spider8 sdkconfig 默认值（首次配置时生效，可用 menuconfig 覆盖）
# 目标硬件：ESP32-S3-N16R8（16MB Flash + 8MB Octal PSRAM）
# =============================================================

# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32s3"

# --- CPU：240MHz 双核 ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# --- Flash：16MB QIO @80MHz ---
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# --- 自定义分区表（双 OTA + littlefs 动作库 + coredump）---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- PSRAM：N16R8 为 8MB Octal @80MHz ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# --- FreeRTOS：1kHz tick（步态引擎 20ms 插值周期需要精细延时）---
CONFIG_FREERTOS_HZ=1000

# --- 控制台：走 ESP32-S3 原生 USB Serial/JTAG ---
# 为什么不用 UART0：本板"UART"口的 CH340 在这台机器上驱动不可用，只能插"USB"口，
# 而 UART0 的 TX/RX 只出现在"UART"口上。所以日志 + 命令行都必须走 USB Serial/JTAG。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- 日志级别：INFO（调试时可改 DEBUG）---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- 编译优化：-Og，调试期保留断点体验（量产改 PERF）---
CONFIG_COMPILER_OPTIMIZATION_DEBUG=y

# --- 无线测试台：机器狗自己开热点，网页控制台内嵌在固件里 ---
# 关掉这一项即可把 Wi-Fi 协议栈整体摘掉（省 RAM / 省电），有线串口不受影响
# CONFIG_SPIDER8_WIFI_ENABLED is not set

# --- 系统事件任务栈：Wi-Fi 事件回调里要做中文日志 + 连接 + 模式切换，
# 默认 2304 实测溢出（sys_evt stack overflow），提到 4608 ---
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4608

# --- 语音前端 esp-sr（I1 合壳，配置已在 E:\spider8_i0_probe 编译验证）---
# 只留一个唤醒词「你好小智」+ 中文 MultiNet7 量化版，其余模型全关，
# srmodels.bin 实测 2.9 MB，落在 0x800000 的 model 分区（3.5 MB）。
# 这些项必须写进 defaults：将来删掉 sdkconfig 重建时，Kconfig 默认值
# 会打开一堆用不到的模型，把模型分区撑爆。
CONFIG_MODEL_IN_FLASH=y
# CONFIG_MODEL_IN_SDCARD is not set
CONFIG_AFE_INTERFACE_V1=y
CONFIG_SR_NSN_WEBRTC=y
CONFIG_SR_VADN_WEBRTC=y
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
CONFIG_SR_MN_EN_NONE=y
# CONFIG_SR_MN_CN_NONE is not set
# 应急开关：设 n 可让 app_main 不启动语音前端，退回纯蓝牙/串口遥控
CONFIG_SPIDER8_VOICE_ENABLED=y
