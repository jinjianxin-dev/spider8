{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "serialPort",
      "type": "promptString",
      "description": "ESP32-S3 串口号（设备管理器 → 端口，如 COM7）",
      "default": "COM7"
    }
  ],
  "tasks": [
    {
      "label": "ESP-IDF: 编译 (build)",
      "type": "shell",
      "command": "${workspaceFolder}\\tools\\idf.ps1",
      "args": ["build"],
      "options": {
        "cwd": "${workspaceFolder}/firmware",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "ESP-IDF: 烧写 (flash)",
      "type": "shell",
      "command": "${workspaceFolder}\\tools\\idf.ps1",
      "args": ["-Port", "${input:serialPort}", "flash"],
      "options": {
        "cwd": "${workspaceFolder}/firmware",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]
        }
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "ESP-IDF: 串口监视 (monitor)",
      "type": "shell",
      "command": "${workspaceFolder}\\tools\\idf.ps1",
      "args": ["-Port", "${input:serialPort}", "monitor"],
      "options": {
        "cwd": "${workspaceFolder}/firmware",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]
        }
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "ESP-IDF: 编译+烧写+监视 (一键)",
      "type": "shell",
      "command": "${workspaceFolder}\\tools\\idf.ps1",
      "args": ["-Port", "${input:serialPort}", "flash", "monitor"],
      "options": {
        "cwd": "${workspaceFolder}/firmware",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]
        }
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "ESP-IDF: 设置目标芯片 (esp32s3)",
      "type": "shell",
      "command": "${workspaceFolder}\\tools\\idf.ps1",
      "args": ["set-target", "esp32s3"],
      "options": {
        "cwd": "${workspaceFolder}/firmware",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]
        }
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "ESP-IDF: 菜单配置 (menuconfig)",
      "type": "shell",
      "command": "${workspaceFolder}\\tools\\idf.ps1",
      "args": ["menuconfig"],
      "options": {
        "cwd": "${workspaceFolder}/firmware",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]
        }
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "ESP-IDF: 全量清理 (fullclean)",
      "type": "shell",
      "command": "${workspaceFolder}\\tools\\idf.ps1",
      "args": ["fullclean"],
      "options": {
        "cwd": "${workspaceFolder}/firmware",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]
        }
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      }
    }
  ]
}
