{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "serialPort",
      "type": "promptString",
      "description": "ESP32-S3 串口号（设备管理器 → 端口，如 COM7）",
      "default": "COM7"
    }
  ],
  "tasks": [
    {
      "label": "ESP-IDF: 编译 (build)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\idf.ps1",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "ESP-IDF: 烧写 (flash)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\idf.ps1",
        "-Port",
        "${input:serialPort}",
        "flash"
      ],
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "ESP-IDF: 串口监视 (monitor)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\idf.ps1",
        "-Port",
        "${input:serialPort}",
        "monitor"
      ],
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "ESP-IDF: 编译+烧写+监视 (一键)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\idf.ps1",
        "-Port",
        "${input:serialPort}",
        "flash",
        "monitor"
      ],
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "ESP-IDF: 设置目标芯片 (esp32s3)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\idf.ps1",
        "set-target",
        "esp32s3"
      ],
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "ESP-IDF: 菜单配置 (menuconfig)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\idf.ps1",
        "menuconfig"
      ],
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "ESP-IDF: 全量清理 (fullclean)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\idf.ps1",
        "fullclean"
      ],
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
