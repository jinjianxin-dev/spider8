<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#F2F4F6" />
            <stroke android:width="1dp" android:color="@color/sp8_line" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sp8_accent_soft" />
            <stroke android:width="1dp" android:color="@color/sp8_accent" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sp8_card" />
            <stroke android:width="1dp" android:color="@color/sp8_line" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
